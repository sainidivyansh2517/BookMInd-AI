# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (Atlas URI or local URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookmind?retryWrites=true&w=majority

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g., gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS (e.g., https://your-app.vercel.app or http://localhost:3000)
CLIENT_URL=http://localhost:3000
