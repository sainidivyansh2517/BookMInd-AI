# =================================================================
# BookMind AI - Server Environment Variables (Template / Example)
# Copy this file to `server/.env` and fill in your actual credentials.
# NEVER commit your real `.env` file to source control!
# =================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Storage Engine Mode:
# 'mongodb' (Default & REQUIRED in production) | 'json' (Explicit local offline fallback only)
STORAGE_MODE=mongodb

# JWT Authentication Secret (Required - must be a cryptographically strong string)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here

# MongoDB Connection String
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/bookmind?retryWrites=true&w=majority
# or local: mongodb://127.0.0.1:27017/bookmind
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookmind?retryWrites=true&w=majority

# Google Gemini API Key (Generate at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://book-m-ind-ai.vercel.app
